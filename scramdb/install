#!/bin/bash
set -euo pipefail

# Native install: the official one-command installer, pinned to a single build
# so the run is reproducible. The installer resolves the host architecture
# itself (linux/amd64 and linux/arm64 tarballs are published for every build)
# and verifies every download against that release's SHA256SUMS before it
# writes anything, so nothing here is architecture-specific.

: "${HOME:?HOME must be set: the install directory lives under it}"

BENCH_DIR="$(cd "$(dirname "$0")" && pwd)"
VERSION="${SCRAMDB_VERSION:-9bc01a7}"
INSTALL_DIR="${SCRAMDB_INSTALL_DIR:-$HOME/.scramdb}"
BIN="$INSTALL_DIR/bin/scramdb"

# psql drives load/query/check; bc converts psql's millisecond timings.
sudo apt-get update -y
sudo apt-get install -y postgresql-client bc

# A server left behind by a previous run still holds the data directory.
"$BENCH_DIR/stop"

ram_kb=$(awk '/MemTotal/ { print $2 }' /proc/meminfo)
ram_gb=$(( ram_kb / 1024 / 1024 ))

if [ "$ram_gb" -lt 16 ]; then
    echo "WARNING: ScramDB targets machines with at least 16 GB of RAM; this one has ${ram_gb} GB." >&2
    echo "WARNING: proceeding anyway, but this result is not representative of the product." >&2
fi

curl -fsSL https://scramdb.com/install \
    | SCRAMDB_YES=1 SCRAMDB_MODIFY_PATH=0 SCRAMDB_INSTALL_DIR="$INSTALL_DIR" \
      bash -s -- --version "$VERSION"

if [ ! -x "$BIN" ]; then
    echo "install: the installer produced no executable at $BIN" >&2
    exit 1
fi

rm -rf "$BENCH_DIR/db"
mkdir -p "$BENCH_DIR/db"
rm -f "$BENCH_DIR/scramdb.log" "$BENCH_DIR/scramdb.pid"

# The installed defaults, with four changes a benchmark box needs: WAL
# archiving off (the box does no point-in-time recovery, and archived segments
# would otherwise count into data_size), statistics on load off (the load runs
# its own ANALYZE inside the timed window), and the UDF and GPU lanes off
# (nothing beyond the benchmark runs).
#
# Below 8 GB the ingest pipeline is sized to the machine: the default batch
# times pipeline depth is a working set a 4 GB box does not have.
SMALL_BOX=""
if [ "$ram_gb" -lt 8 ]; then
    SMALL_BOX=$'\n[execution]\ncopy_batch_rows = 16384\ncopy_pipeline_depth = 2\ncopy_consumers = 1'
fi

cat > "$BENCH_DIR/scramdb-config.toml" <<EOF
[general]
jit_enabled = true
metrics_port = 9090
pg_address = "0.0.0.0:5432"

[storage]
prod_name = "tundra"
shard_id = 0
basedir = "$BENCH_DIR/db"

[storage.wal.archive]
enabled = false

[storage.cold_config]
cold_enable = false

[statistics]
analyze_on_load = false

[udf]
enabled = false

[gpu]
enabled = false
$SMALL_BOX
EOF
