#!/bin/bash
set -euo pipefail

BENCH_DIR="$(cd "$(dirname "$0")" && pwd)"

# The store the config names (a reload may point it away from db); the compiled-query
# cache inside it is derived from the queries, not the data.
DB="$(sed -nE 's/^basedir = "(.*)"/\1/p' "$BENCH_DIR/scramdb-config.toml" 2>/dev/null || true)"
du -sb --exclude=scramvm_cache "${DB:-$BENCH_DIR/db}" | cut -f1
